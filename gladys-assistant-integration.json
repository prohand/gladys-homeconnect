  "widgets": [
    {
      "key": "appliances",
      "label": {
        "en": "Home Connect",
        "fr": "Home Connect"
      },
      "description": {
        "en": "All your appliances and what they are doing, in one card.",
        "fr": "Tous vos appareils et ce qu’ils font, en une carte."
      },
      "icon": "grid",
      "settings": [
        {
          "key": "appliances",
          "type": "multi_select",
          "label": {
            "en": "Appliances",
            "fr": "Appareils"
          },
          "description": {
            "en": "Leave empty to show every Home Connect appliance.",
            "fr": "Laissez vide pour afficher tous les appareils Home Connect."
          },
          "source": "devices"
        }
      ]
    },
    {
      "key": "appliance",
      "label": {
        "en": "Appliance",
        "fr": "Appareil"
      },
      "description": {
        "en": "One appliance: state, program, remaining time and controls.",
        "fr": "Un appareil : état, programme, temps restant et commandes."
      },
      "icon": "box",
      "settings": [
        {
          "key": "appliance",
          "type": "select",
          "label": {
            "en": "Appliance",
            "fr": "Appareil"
          },
          "required": true,
          "source": "devices"
        },
        {
          "key": "controls",
          "type": "boolean",
          "label": {
            "en": "Show the start / stop buttons",
            "fr": "Afficher les boutons démarrer / arrêter"
          },
          "description": {
