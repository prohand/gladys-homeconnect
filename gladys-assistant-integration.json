      "label": {
        "en": "Resume the program",
        "fr": "Reprendre le programme"
      },
      "description": {
        "en": "Restarts a program that was paused.",
        "fr": "Relance un programme mis en pause."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "appliance",
          "type": "select",
          "label": {
            "en": "Appliance",
            "fr": "Appareil"
          },
          "description": {
            "en": "The Home Connect appliance the action runs on.",
            "fr": "L’appareil Home Connect sur lequel l’action s’applique."
          },
          "required": true,
          "source": "devices"
        }
      ]
    },
    {
