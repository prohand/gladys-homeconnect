  "scene_actions": [
    {
      "key": "start_program",
      "label": {
        "en": "Start the selected program",
        "fr": "Démarrer le programme sélectionné"
      },
      "description": {
        "en": "Runs the program already selected on the appliance. Remote start must be armed on it.",
        "fr": "Lance le programme déjà sélectionné sur l’appareil. Le démarrage à distance doit y être activé."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "appliance",
          "type": "select",
          "label": {
            "en": "Appliance",
            "fr": "Appareil"
          },
          "description": {
            "en": "The Home Connect appliance the action runs on.",
            "fr": "L’appareil Home Connect sur lequel l’action s’applique."
          },
          "required": true,
          "source": "devices"
        }
      ],
      "outputs": [
        {
          "key": "program",
          "type": "string",
          "label": {
            "en": "Program",
            "fr": "Programme"
          }
