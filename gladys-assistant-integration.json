        "fr": "Uniquement les appareils qui acceptent la commande pause de Home Connect."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "appliance",
          "type": "select",
          "label": {
            "en": "Appliance",
            "fr": "Appareil"
          },
          "description": {
            "en": "The Home Connect appliance the action runs on.",
            "fr": "L’appareil Home Connect sur lequel l’action s’applique."
          },
          "required": true,
          "source": "devices"
        }
      ]
    },
    {
